# Copy to .env and adjust for the local environment. Values are read by scripts
# or can be exported directly before starting Uvicorn.
# Use 0.0.0.0 for access from other devices on the same LAN.
# Use 127.0.0.1 when a reverse proxy is the only client.
COURSEBOX_HOST=0.0.0.0
COURSEBOX_PORT=8000
COURSEBOX_DB=data/coursebox.db
COURSEBOX_UPLOAD_DIR=uploads
COURSEBOX_MAX_FILE_SIZE=20971520
COURSEBOX_MIN_FREE_SPACE=104857600
# 上传配额（字节）：单课程总量与站点总量上限，0 表示不限制。
# COURSEBOX_MAX_COURSE_BYTES=524288000
# COURSEBOX_MAX_TOTAL_BYTES=2147483648
# 审计日志保留天数，启动时与 `py -m app.maintenance` 都会按它清理。
# COURSEBOX_AUDIT_RETENTION_DAYS=90
COURSEBOX_ALLOWED_EXTENSIONS=.7z,.csv,.doc,.docx,.gif,.jpeg,.jpg,.md,.pdf,.png,.ppt,.pptx,.rar,.txt,.xls,.xlsx,.zip
COURSEBOX_LOG_LEVEL=INFO
# Optional when py/python is not on PATH, for example on a locked-down Windows host.
# COURSEBOX_PYTHON=C:\Python314\python.exe
COURSEBOX_ADMIN_USERNAME=admin
COURSEBOX_ADMIN_PASSWORD=change-this-password
# development（默认）允许回退到内置默认密码；production 缺少或过短的管理员密码会拒绝启动。
COURSEBOX_ENV=development
# 会话 Cookie 的 Secure 标记，默认跟随 COURSEBOX_ENV（生产开启）。局域网 http 访问时请保持关闭。
# COURSEBOX_COOKIE_SECURE=false
# 同一账号在同一来源连续失败多少次后临时锁定，以及锁定时长（秒）。
# COURSEBOX_LOGIN_MAX_ATTEMPTS=5
# COURSEBOX_LOGIN_LOCKOUT_SECONDS=300
# 备份脚本（py -m app.backup）的输出目录与保留份数，0 表示全部保留。
# COURSEBOX_BACKUP_DIR=backups
# COURSEBOX_BACKUP_KEEP=7
